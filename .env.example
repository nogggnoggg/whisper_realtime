# OpenAI API 金鑰（必填）
# 請至 https://platform.openai.com/api-keys 取得，並填入實際金鑰
OPENAI_API_KEY=sk-...

# HTTP 伺服器埠號（選填，預設 3000）
PORT=3000

# ── 語音轉錄設定（以下變數改完須重啟 server 才會生效）────────────────────────────────

# 轉錄模型（選填，預設 gpt-realtime-whisper）
# 可選值：gpt-realtime-whisper | gpt-4o-transcribe
# 注意：STT_PROMPT 僅在 gpt-4o-transcribe 時有效；gpt-realtime-whisper 不支援 prompt
STT_MODEL=gpt-realtime-whisper

# 精度/延遲權衡（選填，預設 medium）
# 合法值：minimal | low | medium | high | xhigh
# 值越高辨識精度越佳但延遲越大；medium 為兼顧即時性與準確度的均衡點
# 路徑：session.audio.input.transcription.delay（2026-06-12 實測確認）
STT_DELAY=medium

# 降噪模式（選填，預設 near_field）
# 合法值：near_field（近場麥，如配戴式或桌上麥）| far_field（遠場麥，如吊掛麥）| off（不啟用）
# 設為 off 時不送此欄位給 API；'auto' 不被 API 支援
# 路徑：session.audio.input.noise_reduction（2026-06-12 實測確認）
STT_NOISE_REDUCTION=near_field

# 轉錄提示詞（選填，僅 gpt-4o-transcribe 生效）
# 留空（不設此變數）則自動使用內建工廠術語預設值：
#   品保 QA、隔離區 quarantine area、停線 stop the line、卡料 material jam、
#   首件檢查 first article inspection、良品 good parts、不良品 defective parts、
#   出貨 ship、貼標籤 label
# 設為空字串（STT_PROMPT=）則明確不送提示詞
# 設為自訂字串則覆蓋預設值
# 路徑：session.audio.input.transcription.prompt（2026-06-12 實測確認）
# STT_PROMPT=

# ── 翻譯設定 ────────────────────────────────────────────────────────────────────

# 翻譯供應商（選填，預設 openai）
# 可選值：openai | anthropic | custom
#
# 各 provider 典型組合範例：
#
#   [openai — gpt-5 系列，推薦即時翻譯]
#     TRANSLATE_PROVIDER=openai
#     TRANSLATE_MODEL=gpt-5-mini          # 預設值，可省略
#     OPENAI_API_KEY=sk-...               # 沿用上方必填金鑰
#
#   [openai — 非 gpt-5 系列（自動切換為 max_tokens + temperature 模式）]
#     TRANSLATE_PROVIDER=openai
#     TRANSLATE_MODEL=gpt-4o-mini
#     OPENAI_API_KEY=sk-...
#
#   [anthropic — claude-haiku-4-5，快速低成本翻譯]
#     TRANSLATE_PROVIDER=anthropic
#     TRANSLATE_MODEL=claude-haiku-4-5    # 預設值，可省略
#     ANTHROPIC_API_KEY=sk-ant-...
#
#   [custom — Gemini（Google AI Studio OpenAI 相容端點）]
#     TRANSLATE_PROVIDER=custom
#     TRANSLATE_MODEL=gemini-2.0-flash    # 必填
#     TRANSLATE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     TRANSLATE_API_KEY=AIza...
#
#   [custom — Groq]
#     TRANSLATE_PROVIDER=custom
#     TRANSLATE_MODEL=llama-3.3-70b-versatile
#     TRANSLATE_BASE_URL=https://api.groq.com/openai/v1
#     TRANSLATE_API_KEY=gsk_...
#
#   [custom — Ollama（本機，無需 API Key）]
#     TRANSLATE_PROVIDER=custom
#     TRANSLATE_MODEL=llama3.2
#     TRANSLATE_BASE_URL=http://localhost:11434/v1
#     # TRANSLATE_API_KEY 可省略，預設填入 'not-needed'
#
TRANSLATE_PROVIDER=openai

# 翻譯模型（選填）
# - openai provider：預設 gpt-5-mini
# - anthropic provider：預設 claude-haiku-4-5
# - custom provider：必填（無預設值）
# TRANSLATE_MODEL=gpt-5-mini

# Anthropic API 金鑰（使用 anthropic provider 時必填）
# 請至 https://console.anthropic.com/settings/keys 取得
# ANTHROPIC_API_KEY=sk-ant-...

# Custom provider 端點 URL（使用 custom provider 時必填）
# 必須為 OpenAI Chat Completions 相容端點
# TRANSLATE_BASE_URL=https://api.example.com/v1

# Custom provider API 金鑰（使用 custom provider 時選填）
# 若端點不需要金鑰（如本機 Ollama），可省略；預設填入 'not-needed'
# TRANSLATE_API_KEY=your-api-key-here
